# Store your name in variable and print it
name = "Yash"
print("Hello", name)

# Store two numbers in variables and print their sum
num1 = 3
num2 = 2
sum = num1 + num2
print("The sum of", num1, "and", num2, "is", sum)

# Check the datatype of the variable using type() function
age = 18 
course = "Python Programming"
is_logged_in = True
print("Age:", type(age))
print("Course:", type(course))
print("Is logged in:", type(is_logged_in))

# Take user input for age and print it
age = int(input("Enter your age: "))
print("Your age is:", age)

# Convert a string "100" into an integer and print the result
string_number = "100"
integer_number = int(string_number)
print("The integer value is:", integer_number)

# Store a float value in a variable and print its datatype
pi = 3.14
print("The datatype of pi is:", type(pi))

# Swap two variables
a = 5
b = 10
c = a
print("Before swapping: a =", a, "b =", b)
a = b
b = c
print("After swapping: a =", a, "b =", b)

# Take two numbers as input and print their multiplication
num1 = int(input("Enter the first number: "))
num2 = int(input("Enter the second number: "))
result = num1 * num2
print("The multiplication of", num1, "and", num2, "is", result)

